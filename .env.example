# Google Sheets API Configuration
# Get this from Google Apps Script deployment
VITE_GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google Sheet ID (from the spreadsheet URL)
# Example: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
VITE_GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional: Enable Google Sheets sync (set to 'true' to sync data)
VITE_ENABLE_GOOGLE_SHEETS_SYNC=true

# Optional: Auto-sync interval in milliseconds (default: 60000 = 1 minute)
VITE_SYNC_INTERVAL=60000
